{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mcms/config/tsconfig/electron",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "./dist/main",
    "rootDir": "./src"
  },
  "include": ["src/main/**/*", "src/storage/**/*"],
  "exclude": ["node_modules", "dist", "src/renderer/**/*"]
}
