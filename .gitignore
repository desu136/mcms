# ─── Node / pnpm ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.pnpm-store/

# ─── Build outputs ──────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─── Next.js ────────────────────────────────────────────────
.next/
apps/web/.next/
apps/web/out/

# ─── Turborepo ──────────────────────────────────────────────
.turbo/

# ─── Environment variables ──────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
turbo-log/

# ─── OS files ───────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editor directories ─────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Allow shared VS Code workspace settings if team commits them
# .vscode/

# ─── TypeScript / Prisma ────────────────────────────────────
apps/api/prisma/migrations/migration_lock.toml
# Generated Prisma client (regenerated from schema)
apps/api/node_modules/.prisma/

# ─── Flutter / Dart ─────────────────────────────────────────
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/.packages
# pubspec.lock is committed for reproducible builds in app repos;
# excluded here because the monorepo treats Flutter as a separate sub-project.
apps/mobile/pubspec.lock
# Generated code
apps/mobile/**/*.g.dart
apps/mobile/**/*.freezed.dart
# Platform directories generated by flutter create (not checked in until targeting that platform)
apps/mobile/android/
apps/mobile/ios/
apps/mobile/linux/
apps/mobile/macos/
apps/mobile/windows/
apps/mobile/web/

# ─── Electron ───────────────────────────────────────────────
apps/desktop/release/
# dist/ is already covered above; added specifically for clarity
apps/desktop/dist/

# ─── Docker ─────────────────────────────────────────────────
infrastructure/data/

# ─── Test coverage ──────────────────────────────────────────
coverage/
lcov.info
.nyc_output/

# ─── Miscellaneous ──────────────────────────────────────────
*.local
*.swp
*.bak
