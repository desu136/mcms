{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mcms/config/tsconfig/react-library",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
