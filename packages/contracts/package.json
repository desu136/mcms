{
  "name": "@mcms/contracts",
  "version": "0.0.1",
  "private": true,
  "description": "Shared API contracts, request/response types for TypeScript applications",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "import": "./dist/health/index.js",
      "default": "./dist/health/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mcms/domain": "workspace:*"
  },
  "devDependencies": {
    "@mcms/config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
